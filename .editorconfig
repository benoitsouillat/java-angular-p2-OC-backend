root = true

# Par défaut : tabulations
[*]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML : les tabulations sont interdites par la spec, espaces obligatoires
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown : les espaces en fin de ligne servent de saut de ligne
[*.md]
trim_trailing_whitespace = false
